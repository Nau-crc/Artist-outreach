# ─────────────────────────────────────────────────────────────
# .env.production — variables para el deploy OVH.
# COPIAR a .env.production en el servidor y rellenar. NUNCA subir a git.
# ─────────────────────────────────────────────────────────────

# ──── Dominio y HTTPS ──────────────────────────────────────
APP_DOMAIN=losxavis.com
LETSENCRYPT_EMAIL=you@example.com

# ──── URLs públicas ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://losxavis.com
EXPO_PUBLIC_API_URL=https://losxavis.com

# ──── Base de datos (Neon) ─────────────────────────────────
# Runtime: pooled URL (?pgbouncer=true&connection_limit=1)
DATABASE_URL=postgresql://…-pooler…neon.tech/…?sslmode=require&pgbouncer=true&connection_limit=1
# Solo para migraciones (opcional aquí, se pasa inline al db:deploy)
# DATABASE_MIGRATIONS_URL=postgresql://…-unpooled…neon.tech/…?sslmode=require

# ──── Supabase Auth ────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJ…
SUPABASE_JWT_SECRET=…                # opcional, HS256 legacy fallback
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ…

# ──── Resend ───────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Artist Outreach <no-reply@losxavis.com>
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# ──── Cron ─────────────────────────────────────────────────
# Secreto que el cron externo (GitHub Actions) envía en el header
# Authorization al llamar a /api/cron/consent-queue.
CRON_SECRET=<genera con: openssl rand -hex 32>

# ──── Node ─────────────────────────────────────────────────
NODE_ENV=production
