# Metro (bundler de Expo/React Native) no entiende el layout aislado de pnpm.
# Con node-linker=hoisted, pnpm crea un node_modules plano estilo npm — es
# lo que RN/Expo esperan. Doc oficial: https://docs.expo.dev/guides/monorepos/#pnpm
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true
