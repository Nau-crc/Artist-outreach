shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Expo + React Native + pnpm monorepo:
# Jest y Metro asumen que estas deps están en top-level node_modules.
# Sin hoist, la transformación ESM del preset RN falla y Metro no las resuelve.
# Ver https://docs.expo.dev/guides/monorepos/
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=react-native*
public-hoist-pattern[]=@expo*
public-hoist-pattern[]=expo*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-css-interop
public-hoist-pattern[]=@babel/runtime
