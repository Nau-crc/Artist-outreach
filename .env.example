# Postgres — local (Docker Compose) o Supabase managed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_outreach

# Supabase Auth (production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Resend (fase 4+)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Rate limit (Upstash — fase 4+)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron (fase 6)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Desarrollo local — DEV_BYPASS_AUTH=true inyecta un admin dummy en el backend
# sin verificar JWT. Solo funciona si NODE_ENV != 'production'. Nunca lo
# actives en prod.
DEV_BYPASS_AUTH=true
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000001
