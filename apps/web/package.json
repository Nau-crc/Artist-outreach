{
  "name": "@artist-outreach/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate --schema=../../prisma/schema.prisma && next build",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@artist-outreach/config": "workspace:*",
    "@artist-outreach/shared": "workspace:*",
    "@artist-outreach/ui": "workspace:*",
    "@prisma/client": "6.19.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "csv-parse": "^5.5.6",
    "jsonwebtoken": "^9.0.2",
    "next": "16.3.3",
    "nodemailer": "^9.1.0",
    "pino": "^9.5.0",
    "resend": "^6.25.0",
    "robots-parser": "^3.0.1",
    "pino-pretty": "^11.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^7.0.2",
    "dotenv": "^16.4.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
